# Copy to `.env` and fill in. Never commit the real file.

# Postgres connection string.
# Local: `docker compose up -d` starts a database matching this value.
DATABASE_URL=postgresql://erth:erth@127.0.0.1:5434/erth

# Long random string used to sign admin sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PAYLOAD_SECRET=change-me

# Public origin of the site, without a trailing slash. Used for admin links and CORS.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Where uploaded files are written. Relative paths resolve from the project root.
# On the server, point this at a directory outside the release folder so deploys never touch it.
UPLOADS_DIR=uploads

# Largest single upload the admin accepts, in megabytes (videos are the large ones).
# Keep nginx `client_max_body_size` at least this high.
MAX_UPLOAD_MB=2048
